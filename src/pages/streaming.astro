---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import DiscordButton from '../components/DiscordButton.astro';

// Channel links: add a url when each channel is confirmed; empty entries render as "coming soon".
const channels = [
  { name: 'LIVE CHANNEL', url: '' },
  { name: 'VIDEOS & VODS', url: '' },
  { name: 'CLIPS & SOCIALS', url: '' },
];

const looks = [
  { img: 'dappernanner-studio', title: 'THE CLASSIC', caption: 'Top hat, gold monocle, bow tie, black suit. Full formal for the main event.' },
  { img: 'dappernanner-bowler', title: 'THE BOWLER', caption: 'Bowler hat and the same impeccable manners. Casual Friday, banana style.' },
];
---
<BaseLayout title="Streaming | DapperNanner & The Nannerati | Top-Notch Gaming" description="Meet DapperNanner, Top-Notch Gaming's featured streamer, and The Nannerati, his community of distinguished bananas.">

    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="tng-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-20 pb-20 grid lg:grid-cols-[1fr_auto] gap-12 items-center">
        <div>
          <span class="text-[#c20e0e] text-xs font-black tracking-widest block mb-4">// NOW FEATURING</span>
          <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-[#e4e4e7] leading-tight mb-6">
            DAPPER<span class="text-[#f5c518]">NANNER</span>
          </h1>
          <p class="text-zinc-400 text-sm md:text-base normal-case max-w-2xl font-normal leading-relaxed mb-4">
            A gentleman, a scholar, and a banana. DapperNanner is Top-Notch Gaming's featured streamer: top hat, gold monocle, bow tie, and impeccable manners, even mid-clutch.
          </p>
          <p class="text-zinc-400 text-sm md:text-base normal-case max-w-2xl font-normal leading-relaxed mb-10">
            Every stream is backed by The Nannerati, the most distinguished community on the internet.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#watch" class="bg-[#c20e0e] hover:bg-[#9e0b0b] text-white font-black px-8 py-4 text-xs tracking-widest text-center border border-[#d30000] shadow-[0_0_20px_rgba(194,14,14,0.25)] transition">
              WHERE TO WATCH
            </a>
            <a href="#nannerati" class="bg-transparent hover:bg-[#f5c518] text-[#f5c518] hover:text-black font-black px-8 py-4 text-xs tracking-widest text-center border border-[#f5c518] transition">
              JOIN THE NANNERATI
            </a>
          </div>
        </div>
        <img src="/images/nannerati-logo.webp" width="720" height="720" alt="The Nannerati logo: three golden bananas in a circular emblem" class="w-64 sm:w-80 lg:w-96 h-auto mx-auto rounded-full border-2 border-[#f5c518]/70 shadow-[0_0_60px_rgba(245,197,24,0.3)]" fetchpriority="high" />
      </div>
    </section>

    <!-- Looks -->
    <section class="max-w-7xl mx-auto px-6 py-20">
      <SectionHeader kicker="THE WARDROBE" title="ALWAYS DRESSED FOR THE OCCASION" />
      <div class="grid md:grid-cols-2 gap-8">
        {looks.map((l) => (
          <figure class="bg-[#121215] border border-[#27272a] hover:border-[#f5c518]/60 transition-colors group">
            <div class="relative overflow-hidden">
              <img src={`/images/${l.img}-800.webp`} srcset={`/images/${l.img}-800.webp 800w, /images/${l.img}.webp 1408w`} sizes="(min-width: 768px) 50vw, 100vw" width="800" height="436" alt={`DapperNanner, ${l.title.toLowerCase()} look`} class="w-full h-auto block group-hover:scale-[1.02] transition-transform duration-500" loading="lazy" />
              <div class="tng-scanlines absolute inset-0 pointer-events-none" aria-hidden="true"></div>
            </div>
            <figcaption class="p-6">
              <h3 class="text-lg font-black text-[#e4e4e7] mb-2 group-hover:text-[#f5c518] transition-colors">{l.title}</h3>
              <p class="text-zinc-400 text-sm normal-case leading-relaxed">{l.caption}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- The Nannerati -->
    <section id="nannerati" class="bg-[#121215] border-y border-[#27272a] py-20 scroll-mt-20">
      <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-[#f5c518] text-xs font-black tracking-widest block mb-2">// THE COMMUNITY</span>
          <h2 class="text-3xl md:text-4xl font-black text-[#e4e4e7] mb-6">THE <span class="text-[#f5c518]">NANNERATI</span></h2>
          <p class="text-zinc-400 text-sm md:text-base normal-case leading-relaxed mb-4">
            Every great banana needs a bunch. The Nannerati are DapperNanner's community: the regulars in chat, the friends in the lobby, and the council that keeps the stream running smoothly.
          </p>
          <p class="text-zinc-400 text-sm md:text-base normal-case leading-relaxed mb-8">
            Membership requires no secret handshake. Show up, say hi, and keep it classy.
          </p>
          <a href="/community/" class="inline-block bg-transparent hover:bg-[#f5c518] text-[#f5c518] hover:text-black font-black px-8 py-4 text-xs tracking-widest border border-[#f5c518] transition">
            ENTER THE COMMUNITY
          </a>
        </div>
        <div class="tng-cut border border-[#27272a] bg-black p-2">
          <img src="/images/nannerati-council.webp" width="974" height="519" alt="The Nannerati council: suited bananas around a table bearing the Nannerati emblem" class="w-full h-auto block" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- Where to watch -->
    <section id="watch" class="max-w-7xl mx-auto px-6 py-20 scroll-mt-20">
      <SectionHeader kicker="TUNE IN" title="WHERE TO WATCH" />
      <div class="grid md:grid-cols-3 gap-6 mb-10">
        {channels.map((c) => (
          c.url ? (
            <a href={c.url} target="_blank" rel="noopener noreferrer" class="bg-[#121215] border border-[#27272a] p-8 hover:border-[#c20e0e]/60 transition-colors">
              <div class="text-xs font-black text-[#c20e0e] mb-3">● ONLINE</div>
              <div class="text-lg font-black text-[#e4e4e7]">{c.name}</div>
            </a>
          ) : (
            <div class="bg-[#121215] border border-dashed border-[#27272a] p-8">
              <div class="text-xs font-black text-zinc-500 mb-3">○ LINK COMING SOON</div>
              <div class="text-lg font-black text-[#e4e4e7]">{c.name}</div>
            </div>
          )
        ))}
      </div>
      <div class="bg-[#121215] border border-[#27272a] p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="text-xs font-black text-[#c20e0e] mb-2">// STREAM SCHEDULE</div>
          <p class="text-zinc-400 text-sm normal-case">Schedule to be announced. Go-live alerts will be posted in the community Discord.</p>
        </div>
        <DiscordButton size="sm" />
      </div>
    </section>

</BaseLayout>
