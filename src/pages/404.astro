---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 | Top-Notch Gaming" description="Page not found.">
  <section class="max-w-4xl mx-auto px-6 py-32 text-center">
    <span class="text-[#c20e0e] text-xs font-black tracking-widest block mb-4">// ERROR 404</span>
    <h1 class="text-5xl md:text-7xl font-black text-[#e4e4e7] mb-6">GAME <span class="text-[#c20e0e]">OVER</span></h1>
    <p class="text-zinc-400 text-sm normal-case mb-10">That page doesn't exist. Respawn at the home screen?</p>
    <a href="/" class="inline-block bg-[#c20e0e] hover:bg-[#9e0b0b] text-white font-black px-10 py-5 text-xs tracking-widest border border-[#d30000] transition">CONTINUE</a>
  </section>
</BaseLayout>
