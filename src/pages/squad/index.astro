---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { SQUAD, memberSlug, wowCharacters, wowCharacterSlug } from '../../data/squad';
import { characterDisplayName, loadSnapshot, mediaAsset, wowHref } from '../../lib/characters';
---
<BaseLayout title="Squad | Top-Notch Gaming" description="Members of Top-Notch Gaming and their World of Warcraft: Forever characters.">
  <section class="max-w-7xl mx-auto px-6 pt-20 pb-24">
    <SectionHeader kicker="TNG // MEMBERS" title="SQUAD" class="mb-12" />
    <ul class="grid gap-6">
      {SQUAD.map((member) => {
        const wow = wowCharacters(member);
        return (
          <li class="bg-[#121215] border border-[#27272a] p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-3 mb-4">
              <h2 class="text-2xl font-black text-[#e4e4e7] m-0 normal-case tracking-wide">{member.handle}</h2>
              {wow.length > 0 && (
                <a href={wowHref(member)} class="text-[10px] font-black tracking-widest text-[#c20e0e] hover:text-white transition">WOWforever →</a>
              )}
            </div>
            {wow.length === 0 ? (
              <p class="text-zinc-500 text-sm normal-case m-0">No WoW Forever characters listed yet.</p>
            ) : (
              <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
                {wow.map((character) => {
                  const snapshot = loadSnapshot(memberSlug(member), wowCharacterSlug(character));
                  const avatar = mediaAsset(snapshot, 'avatar');
                  return (
                    <li>
                      <a href={wowHref(member, character)} class="flex items-center gap-3 bg-black border border-[#27272a] hover:border-[#c20e0e]/60 p-3 transition-colors">
                        {avatar ? (
                          <img src={avatar} alt="" width="40" height="40" class="size-10 object-cover border border-[#27272a] shrink-0" />
                        ) : (
                          <span class="size-10 border border-dashed border-[#3f3f46] shrink-0" aria-hidden="true"></span>
                        )}
                        <span class="min-w-0">
                          <span class="block font-black text-sm text-[#e4e4e7] normal-case">{characterDisplayName(character, snapshot)}</span>
                          <span class="block text-[10px] text-zinc-500 tracking-widest">
                            {snapshot?.profile?.faction?.name ?? 'WoW Forever'}
                            {snapshot?.profile?.level != null && ` · LV ${snapshot.profile.level}`}
                          </span>
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </li>
        );
      })}
    </ul>
  </section>
</BaseLayout>
