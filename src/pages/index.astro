---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import DiscordButton from '../components/DiscordButton.astro';

const pillars = [
  { code: '01 // SQUAD', title: 'COMMUNITY FIRST', description: 'A welcoming place to queue up, trade strats, and hang out with people who love games as much as you do.' },
  { code: '02 // PLAY', title: 'GAME NIGHTS & EVENTS', description: 'Community play sessions and events. Dates are announced in the community first, so keep an eye on the Discord.' },
  { code: '03 // CREATE', title: 'ROOM FOR CREATORS', description: 'Clips, content, and creative projects from players in the Top-Notch family, with a community behind them.' },
  { code: '04 // NETWORK', title: 'PART OF TOP-NOTCH', description: 'Top-Notch Gaming is the gaming arm of Top-Notch Network, built on the same standard: show up, play fair, lift others up.' },
];

const hud = [
  ['MODE', 'CO-OP'],
  ['LOBBY', 'OPEN'],
  ['SKILL LEVEL', 'ALL WELCOME'],
  ['NETWORK', 'TOP-NOTCH'],
];
---
<BaseLayout title="Top-Notch Gaming | Community & Game Nights" description="Top-Notch Gaming is the gaming arm of Top-Notch Network: community game nights, squads, and a place for players to connect.">

    <!-- Hero Section -->
    <section class="relative overflow-hidden">
      <div class="tng-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-20 pb-20 grid lg:grid-cols-[1.15fr_0.85fr] gap-12 items-center">
        <div>
          <span class="text-[#c20e0e] text-xs font-black tracking-widest block mb-4">// PRESS START · TOP-NOTCH GAMING</span>
          <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-[#e4e4e7] leading-tight mb-6">
            LEVEL UP <br />
            <span class="text-[#c20e0e]">TOGETHER</span>
          </h1>
          <p class="text-zinc-400 text-sm md:text-base normal-case max-w-2xl font-normal leading-relaxed mb-4">
            Squads, game nights, and good company from the gaming side of Top-Notch Network.
          </p>
          <p class="text-zinc-400 text-sm md:text-base normal-case max-w-2xl font-normal leading-relaxed mb-10">
            Top-Notch Gaming brings players together. Jump into the community, find your squad, and play with people who keep it top-notch.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/community/" class="bg-[#c20e0e] hover:bg-[#9e0b0b] text-white font-black px-8 py-4 text-xs tracking-widest text-center border border-[#d30000] shadow-[0_0_20px_rgba(194,14,14,0.25)] transition">
              JOIN THE COMMUNITY
            </a>
            <a href="/about/" class="bg-[#121215] hover:bg-zinc-800 text-zinc-300 font-bold px-8 py-4 text-xs tracking-widest text-center border border-[#27272a] transition">
              ABOUT TNG
            </a>
          </div>
        </div>

        <!-- HUD panel -->
        <div class="tng-cut relative border border-[#27272a] bg-[#121215] p-8 shadow-[0_0_40px_rgba(194,14,14,0.18)] overflow-hidden" aria-hidden="true">
          <div class="tng-scanlines absolute inset-0 pointer-events-none"></div>
          <div class="relative flex items-center justify-between mb-8">
            <span class="text-[10px] font-black tracking-widest text-[#c20e0e]">● PLAYER 1 READY</span>
            <span class="text-[10px] font-black tracking-widest text-zinc-500">TNG // HUB</span>
          </div>
          <div class="relative flex justify-center mb-8">
            <img src="/tnn-emblem.png" width="198" height="210" alt="" class="h-32 sm:h-40 w-auto drop-shadow-[0_0_30px_rgba(194,14,14,0.5)]" />
          </div>
          <dl class="relative grid grid-cols-2 gap-px bg-[#27272a] border border-[#27272a]">
            {hud.map(([k, v]) => (
              <div class="bg-black px-4 py-3">
                <dt class="text-[10px] font-bold tracking-widest text-zinc-500">{k}</dt>
                <dd class="text-xs font-black tracking-widest text-[#e4e4e7]">{v}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- Pillars Grid -->
    <section class="max-w-7xl mx-auto px-6 py-24">
      <SectionHeader kicker="WHAT WE DO" title="GAMING, THE TOP-NOTCH WAY" class="mb-16" />
      <div class="grid md:grid-cols-2 gap-8">
        {pillars.map((s) => (
          <div class="bg-[#121215] border border-[#27272a] p-8 hover:border-[#c20e0e]/60 transition-colors group">
            <div class="text-xs font-black text-[#c20e0e] mb-4">{s.code}</div>
            <h3 class="text-xl font-black text-[#e4e4e7] mb-3 group-hover:text-[#c20e0e] transition-colors">{s.title}</h3>
            <p class="text-zinc-400 text-sm normal-case leading-relaxed">{s.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA Strip -->
    <section class="border-t border-[#27272a] bg-[#121215] py-20 px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-5xl font-black text-[#e4e4e7] mb-6">
          READY, <span class="text-[#c20e0e]">PLAYER TWO?</span>
        </h2>
        <p class="text-zinc-400 text-sm normal-case max-w-xl mx-auto mb-8">
          The community hub is warming up. Grab a spot on the Discord as soon as the invite goes live.
        </p>
        <DiscordButton />
      </div>
    </section>

</BaseLayout>
