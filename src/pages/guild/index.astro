---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { GAMES } from '../../data/games';
import { guildEvents, guildGames, guildHref, guildPlans } from '../../lib/guild';
const games = guildGames();
---
<BaseLayout title="Guild | Top-Notch Gaming" description="Top-Notch Gaming guild hubs: event calendars, group plans, and boss positions for the games we play.">
  <section class="max-w-7xl mx-auto px-6 pt-20 pb-24">
    <SectionHeader kicker="TNG // GUILD" title="GUILD HUBS" class="mb-6" />
    <p class="text-zinc-400 text-sm normal-case max-w-2xl mb-10">Calendars, group plans, and boss positions for each game we play. Every game uses the same template.</p>
    <ul class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 m-0 p-0 list-none">
      {games.map((g) => {
        const game = GAMES.find((x) => x.slug === g.gameSlug);
        return (
          <li class="bg-[#121215] border border-[#27272a] p-6 min-w-0">
            <a href={guildHref(g)} class="flex items-center gap-4 group">
              {game?.icon && <img src={`${game.icon.src}-128.webp`} alt="" width="56" height="56" class="size-14 border border-[#27272a]" />}
              <span class="min-w-0">
                <span class="block text-xl font-black text-[#e4e4e7] group-hover:text-white normal-case tracking-wide">{g.guildName ?? g.name}</span>
                {g.guildName && <span class="block text-xs text-zinc-400 normal-case tracking-normal mt-0.5">{g.name}</span>}
                <span class="block text-[10px] font-bold tracking-widest text-zinc-500 mt-1">{guildEvents(g.slug).length} events · {guildPlans(g.slug).length} plans</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</BaseLayout>
