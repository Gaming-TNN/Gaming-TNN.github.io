---
import { SITE, NAV } from '../lib/site';
---
    <!-- Footer -->
    <footer class="border-t border-[#27272a] py-10 text-center text-xs text-zinc-400">
      <div class="max-w-7xl mx-auto px-6 flex flex-col items-center gap-5">
        <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 font-bold tracking-widest">
          <a href="/" class="hover:text-white transition">Home</a>
          {NAV.map((n) => <a href={n.href} class="hover:text-white transition">{n.label}</a>)}
          <a href={SITE.parentUrl} class="hover:text-white transition">{SITE.parentName}</a>
        </div>
        <div>© 2026 TOP-NOTCH GAMING · A <a href={SITE.parentUrl} class="text-zinc-300 hover:text-white transition">TOP-NOTCH NETWORK</a> COMPANY. ALL RIGHTS RESERVED.</div>
      </div>
    </footer>
