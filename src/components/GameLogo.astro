---
// Official game logo on a dark panel, or the typographic emblem when no logo is set.
import type { Game } from '../data/games';
import GameEmblem from './GameEmblem.astro';
interface Props { game: Game; size?: 'sm' | 'lg' }
const { game, size = 'lg' } = Astro.props;
const logo = game.logo;
---
{logo ? (
  size === 'lg' ? (
    <img src={`${logo.src}-800.webp`} srcset={`${logo.src}-400.webp 400w, ${logo.src}-800.webp 800w`} sizes="(min-width: 768px) 360px, 80vw" width={logo.width} height={logo.height} alt={logo.alt} class="relative max-h-40 sm:max-h-44 w-auto max-w-full object-contain drop-shadow-[0_6px_18px_rgba(0,0,0,0.8)]" loading="lazy" decoding="async" />
  ) : (
    <img src={`${logo.src}-400.webp`} width={400} height={Math.round((logo.height * 400) / logo.width)} alt={logo.alt} class="h-12 w-24 object-contain shrink-0" loading="lazy" decoding="async" />
  )
) : (
  <GameEmblem mark={game.mark} size={size} />
)}
