---
// Homepage hero slot: placeholder for live TNG Discord voice channels.
// Replace the preview rows with a live widget when the Discord server
// connection is ready. These names are not real channels.
const previewChannels = [
  { name: 'Voice Lounge', listeners: 0 },
  { name: 'Game Night', listeners: 0 },
];
---
<aside class="tng-cut relative border border-[#27272a] bg-[#121215] p-5 sm:p-6 shadow-[0_0_40px_rgba(194,14,14,0.18)] overflow-hidden" aria-labelledby="voice-heading">
  <div class="tng-scanlines absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative flex items-center justify-between gap-3 mb-3">
    <h2 id="voice-heading" class="text-[10px] font-black tracking-widest text-[#c20e0e] m-0">● LIVE VOICE</h2>
    <p class="text-[10px] font-black tracking-widest text-zinc-500 m-0">TNG // VOICE</p>
  </div>
  <p class="relative text-[10px] font-bold tracking-widest text-zinc-500 mb-5">COMING SOON · LIVE CHANNELS FROM THE TNG DISCORD</p>
  <ul class="relative grid grid-cols-1 gap-3" aria-hidden="true">
    {previewChannels.map((channel) => (
      <li class="flex items-center gap-4 bg-black border border-dashed border-[#27272a] p-4 min-w-0 opacity-50 grayscale">
        <div class="shrink-0 size-10 border border-[#3f3f46] bg-[#0a0a0c] flex items-center justify-center text-zinc-500" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
            <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <p class="font-black text-sm text-zinc-400 m-0 truncate">{channel.name}</p>
          <p class="text-[10px] font-bold tracking-widest text-zinc-600 m-0 mt-1">{channel.listeners} IN CHANNEL</p>
        </div>
        <span class="shrink-0 text-[9px] font-black tracking-widest text-zinc-500 border border-[#3f3f46] px-1.5 py-0.5">PREVIEW</span>
      </li>
    ))}
  </ul>
  <p class="relative text-[10px] text-zinc-600 normal-case tracking-normal mt-4 mb-0">Placeholder preview — not live channels.</p>
</aside>
