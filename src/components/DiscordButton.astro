---
// Discord CTA. Shows a disabled "coming soon" placeholder until DISCORD_INVITE_URL is set in src/lib/site.ts.
import { DISCORD_INVITE_URL } from '../lib/site';
interface Props { size?: 'sm' | 'lg'; class?: string }
const { size = 'lg', class: extra = '' } = Astro.props;
const pad = size === 'lg' ? 'px-8 py-4' : 'px-4 py-2.5';
const icon = 'M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.6 1.3a18.4 18.4 0 0 0-5.6 0L8.6 3a19.7 19.7 0 0 0-4.9 1.5C.6 9.1-.3 13.6.1 18.1a19.9 19.9 0 0 0 6 3l1.3-2.1a12.9 12.9 0 0 1-2-1l.5-.4a14.2 14.2 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1l1.3 2.1a19.8 19.8 0 0 0 6-3c.5-5.2-.8-9.7-3.6-13.7ZM8 15.4c-1.2 0-2.2-1.1-2.2-2.4S6.8 10.6 8 10.6s2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z';
---
{DISCORD_INVITE_URL ? (
  <a href={DISCORD_INVITE_URL} target="_blank" rel="noopener noreferrer" class={`inline-flex items-center justify-center gap-3 bg-[#5865F2] hover:bg-[#4752c4] text-white font-black ${pad} text-xs tracking-widest border border-[#7983f5] transition ${extra}`}>
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icon} /></svg>
    JOIN THE DISCORD
  </a>
) : (
  <span role="link" aria-disabled="true" title="Discord invite link coming soon" data-discord-placeholder class={`inline-flex items-center justify-center gap-3 bg-[#121215] text-zinc-400 font-black ${pad} text-xs tracking-widest border border-dashed border-[#5865F2]/70 cursor-not-allowed ${extra}`}>
    <svg class="w-5 h-5 text-[#5865F2]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icon} /></svg>
    DISCORD INVITE COMING SOON
  </span>
)}
