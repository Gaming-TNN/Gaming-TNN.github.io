---
// Site navigation, adapted from the TNN site nav (same structure, sticky bar, dropdown, mobile panel).
import { NAV, NETWORKS, DISCORD_INVITE_URL } from '../lib/site';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path === href.replace(/\/$/, '');
const discordHref = DISCORD_INVITE_URL || '/community/#discord';
const discordExternal = Boolean(DISCORD_INVITE_URL);
---
    <!-- Navigation Bar -->
    <nav class="border-b border-[#27272a] bg-black/95 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">

        <!-- Brand Title & Emblem Logo -->
        <a href="/" class="font-black text-base min-[400px]:text-lg sm:text-xl md:text-2xl tracking-widest text-[#e4e4e7] flex items-center gap-2 sm:gap-3 shrink-0 whitespace-nowrap relative before:absolute before:inset-x-0 before:-inset-y-2">
          <img src="/tnn-emblem.png" alt="Top-Notch emblem" width="198" height="210" class="h-7 w-auto object-contain shrink-0" />
          <span>TOP-NOTCH <span class="text-[#c20e0e]">GAMING</span></span>
        </a>

        <!-- Right Side Nav Elements -->
        <div class="flex items-center gap-6 lg:gap-8">

          <!-- Text Menu Links -->
          <div class="hidden lg:flex items-center space-x-8 text-xs font-bold tracking-widest text-zinc-400">
            {NAV.map((n) => (
              <a href={n.href} class:list={['hover:text-white transition', isActive(n.href) && 'text-white border-b-2 border-[#c20e0e] pb-1']} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
            ))}

            <!-- Networks Dropdown -->
            <div class="relative group">
              <button type="button" class="flex items-center gap-1 hover:text-white transition py-2 uppercase focus:outline-none">
                <span>Networks</span>
                <svg class="w-3 h-3 text-zinc-400 group-hover:text-white transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="absolute right-0 lg:left-0 top-full hidden group-hover:flex group-focus-within:flex flex-col bg-[#121215] border border-[#27272a] w-52 py-2 shadow-2xl z-50">
                {NETWORKS.map((n) => (
                  <a href={n.href} class="px-4 py-2.5 text-[11px] text-zinc-300 hover:text-white hover:bg-[#c20e0e] transition">{n.label.toUpperCase()}</a>
                ))}
              </div>
            </div>
          </div>

          <!-- Action Buttons Group -->
          <div class="hidden lg:flex items-center gap-3">
            <a href="/streaming/" class="bg-[#c20e0e] hover:bg-[#9e0b0b] text-white font-black px-4 py-2.5 text-xs whitespace-nowrap transition border border-[#d30000]">
              WATCH
            </a>
            <a href={discordHref} target={discordExternal ? '_blank' : undefined} rel={discordExternal ? 'noopener noreferrer' : undefined} class="bg-transparent hover:bg-[#5865F2] text-[#8b93f8] hover:text-white font-black px-4 py-2.5 text-xs whitespace-nowrap transition border border-[#5865F2]">
              DISCORD
            </a>
          </div>

          <!-- Mobile Menu Toggle (below lg / 1024px) -->
          <button type="button" id="mobile-menu-toggle" class="lg:hidden inline-flex items-center justify-center w-10 h-10 -mr-2 text-zinc-300 hover:text-white transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[#c20e0e]" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu Panel (below lg / 1024px) -->
      <div id="mobile-menu" class="lg:hidden border-t border-[#27272a] bg-black max-h-[calc(100dvh-5rem)] overflow-y-auto" hidden>
        <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col text-xs font-bold tracking-widest text-zinc-400">
          <a href="/" class:list={['py-3 hover:text-white transition', path === '/' && 'text-white']} data-menu-close>Home</a>
          {NAV.map((n) => (
            <a href={n.href} class:list={['py-3 hover:text-white transition', isActive(n.href) && 'text-white']} data-menu-close>{n.label}</a>
          ))}

          <button type="button" class="group flex items-center justify-between w-full py-3 uppercase tracking-widest hover:text-white transition focus:outline-none focus-visible:text-white" aria-expanded="false" aria-controls="mobile-networks-menu" data-menu-toggle>
            <span>Networks</span>
            <svg class="w-3 h-3 text-zinc-400 group-hover:text-white group-aria-expanded:text-white transition-transform group-aria-expanded:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div id="mobile-networks-menu" class="flex flex-col bg-[#121215] border border-[#27272a] py-2 mb-2" hidden>
            {NETWORKS.map((n) => (
              <a href={n.href} class="block px-4 py-3 text-[11px] text-zinc-300 hover:text-white hover:bg-[#c20e0e] transition">{n.label.toUpperCase()}</a>
            ))}
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-4 mt-2 border-t border-[#27272a]">
            <a href="/streaming/" class="bg-[#c20e0e] hover:bg-[#9e0b0b] text-white font-black px-4 py-3 text-xs text-center transition border border-[#d30000]" data-menu-close>
              WATCH
            </a>
            <a href={discordHref} target={discordExternal ? '_blank' : undefined} rel={discordExternal ? 'noopener noreferrer' : undefined} class="bg-transparent hover:bg-[#5865F2] text-[#8b93f8] hover:text-white font-black px-4 py-3 text-xs text-center transition border border-[#5865F2]" data-menu-close>
              DISCORD
            </a>
          </div>
        </div>
      </div>
      <script is:inline>
        (() => {
          const menu = document.getElementById('mobile-menu');
          const toggle = document.getElementById('mobile-menu-toggle');
          if (!menu || !toggle) return;
          const setOpen = (open) => {
            menu.hidden = !open;
            toggle.setAttribute('aria-expanded', String(open));
            toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          };
          toggle.addEventListener('click', () => setOpen(menu.hidden));
          menu.querySelectorAll('[data-menu-toggle]').forEach((btn) => {
            btn.addEventListener('click', () => {
              const sub = document.getElementById(btn.getAttribute('aria-controls'));
              const open = sub.hidden;
              sub.hidden = !open;
              btn.setAttribute('aria-expanded', String(open));
            });
          });
          menu.querySelectorAll('[data-menu-close]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !menu.hidden) { setOpen(false); toggle.focus(); }
          });
          window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
        })();
      </script>
    </nav>
