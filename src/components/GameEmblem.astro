---
// Typographic emblem (no official game logos/art).
interface Props { mark: string; size?: 'sm' | 'lg' }
const { mark, size = 'lg' } = Astro.props;
const box = size === 'lg' ? 'tng-cut w-24 h-24 text-3xl' : 'w-12 h-12 text-base';
---
<div class={`relative shrink-0 ${box} bg-black border border-[#c20e0e]/70 flex items-center justify-center shadow-[0_0_25px_rgba(194,14,14,0.25)]`} aria-hidden="true">
  <div class="tng-scanlines absolute inset-0 pointer-events-none"></div>
  <span class="relative font-black tracking-widest text-[#e4e4e7]">{mark}</span>
  <span class="absolute bottom-1 right-2 w-1.5 h-1.5 bg-[#c20e0e]"></span>
</div>
