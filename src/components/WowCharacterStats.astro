---
import type { CharacterSnapshot } from '../lib/characters';
import { characterStatGroups } from '../lib/character-stats';

interface Props {
  snapshot?: CharacterSnapshot;
}

const { snapshot } = Astro.props;
const groups = characterStatGroups(snapshot);
---
<section class="mb-14" aria-labelledby="stats-heading">
  <h2 id="stats-heading" class="text-xs font-black tracking-widest text-[#c20e0e] mb-6">STATISTICS</h2>
  {groups.length === 0 ? (
    <p class="text-zinc-500 text-sm normal-case">Statistics snapshot not available yet.</p>
  ) : (
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {groups.map((group) => (
        <div class="bg-[#121215] border border-[#27272a] px-4 py-4 min-w-0">
          <h3 class="text-sm font-black text-[#e4e4e7] m-0 tracking-wide mb-3">{group.title}</h3>
          <dl class="grid gap-1.5 m-0">
            {group.rows.map((row) => (
              <div class="flex justify-between items-baseline gap-3 text-sm normal-case tracking-normal">
                <dt class="text-zinc-400 m-0">{row.label}</dt>
                <dd class="text-[#e4e4e7] font-bold tabular-nums m-0 text-right">{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>
  )}
</section>
