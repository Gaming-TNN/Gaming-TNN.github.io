---
import type { CharacterSnapshot } from '../lib/characters';
import { TALENT_TREE_SOURCE, buildClassViews } from '../lib/talent-trees';

interface Props {
  snapshot?: CharacterSnapshot;
}

const { snapshot } = Astro.props;
const trees = buildClassViews(snapshot);
const totalPoints = trees.reduce((sum, t) => sum + t.points, 0);
const className = snapshot?.profile?.character_class?.name;

const CELL = 40;
const GAP = 12;

function cellCenter(col: number, row: number) {
  return {
    x: (col - 1) * (CELL + GAP) + CELL / 2,
    y: (row - 1) * (CELL + GAP) + CELL / 2,
  };
}

function edgeCoords(fromCol: number, fromRow: number, toCol: number, toRow: number) {
  const from = cellCenter(fromCol, fromRow);
  const to = cellCenter(toCol, toRow);
  const dx = to.x - from.x;
  const dy = to.y - from.y;
  const len = Math.hypot(dx, dy) || 1;
  const inset = CELL / 2;
  return {
    x1: from.x + (dx / len) * inset,
    y1: from.y + (dy / len) * inset,
    x2: to.x - (dx / len) * inset,
    y2: to.y - (dy / len) * inset,
  };
}

function treeSize(cols: number, rows: number) {
  return {
    width: cols * CELL + (cols - 1) * GAP,
    height: rows * CELL + (rows - 1) * GAP,
  };
}
---
<section class="mb-14" aria-labelledby="spec-heading">
  <h2 id="spec-heading" class="text-xs font-black tracking-widest text-[#c20e0e] mb-2">SPECIALIZATION &amp; TALENTS</h2>
  {trees.length === 0 ? (
    <p class="text-zinc-500 text-sm normal-case">Talent tree layout not available yet.</p>
  ) : (
    <>
      <p class="text-zinc-400 text-xs normal-case tracking-normal mb-6">
        {className ? `${className} · ` : ''}{totalPoints} point{totalPoints === 1 ? '' : 's'} spent
      </p>
      <div class="-mx-6 px-6 overflow-x-auto overscroll-x-contain">
        <div class="flex gap-4 lg:gap-6 min-w-min lg:min-w-0 lg:grid lg:grid-cols-3">
          {trees.map((tree) => {
            const size = treeSize(tree.cols, tree.rows);
            return (
              <div class="shrink-0 w-[17.5rem] lg:w-auto bg-[#121215] border border-[#27272a] p-4">
                <header class="flex items-center justify-between gap-3 mb-4">
                  <h3 class="text-sm font-black text-[#e4e4e7] m-0 tracking-wide">{tree.shortName}</h3>
                  <p class="text-[10px] font-bold tracking-widest text-zinc-400 m-0">{tree.points} {tree.points === 1 ? 'POINT' : 'POINTS'}</p>
                </header>
                <div class="relative mx-auto" style={`width:${size.width}px;height:${size.height}px;`}>
                  <svg class="absolute inset-0 pointer-events-none" width={size.width} height={size.height} viewBox={`0 0 ${size.width} ${size.height}`} aria-hidden="true">
                    <defs>
                      <marker id={`arrow-${tree.id}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" fill="#a16207" />
                      </marker>
                    </defs>
                    {tree.edges.map((edge) => {
                      const pts = edgeCoords(edge.fromCol, edge.fromRow, edge.toCol, edge.toRow);
                      return (
                        <line
                          x1={pts.x1}
                          y1={pts.y1}
                          x2={pts.x2}
                          y2={pts.y2}
                          stroke="#a16207"
                          stroke-width="2"
                          marker-end={`url(#arrow-${tree.id})`}
                        />
                      );
                    })}
                  </svg>
                  <div
                    class="relative grid"
                    style={`grid-template-columns:repeat(${tree.cols},${CELL}px);grid-template-rows:repeat(${tree.rows},${CELL}px);gap:${GAP}px;width:${size.width}px;height:${size.height}px;`}
                  >
                    {tree.nodes.map((node) => {
                      const spent = node.rank > 0;
                      const maxed = node.rank >= node.maxRank;
                      const label = `${node.name}, rank ${node.rank} of ${node.maxRank}. ${node.description}`;
                      const tooltipBelow = node.gridRow > tree.rows - 2;
                      return (
                        <button
                          type="button"
                          class:list={[
                            'group relative size-10 border bg-black p-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#c20e0e] focus-visible:ring-offset-2 focus-visible:ring-offset-[#121215]',
                            spent ? 'border-[#ffd100] shadow-[0_0_8px_rgba(255,209,0,0.35)]' : node.available ? 'border-[#52525b]' : 'border-[#27272a]',
                          ]}
                          style={`grid-column:${node.gridCol};grid-row:${node.gridRow};`}
                          aria-label={label}
                        >
                          {node.icon ? (
                            <img
                              src={node.icon}
                              alt=""
                              width="40"
                              height="40"
                              class:list={['size-10 object-cover', spent ? '' : node.available ? 'opacity-80' : 'opacity-35 grayscale']}
                            />
                          ) : (
                            <span class:list={['block size-10', spent ? 'bg-zinc-700' : 'bg-zinc-900']} aria-hidden="true"></span>
                          )}
                          <span
                            class:list={[
                              'absolute -bottom-1 -right-1 min-w-[1.15rem] px-0.5 text-[9px] font-black leading-tight text-center border border-black',
                              maxed ? 'bg-[#ffd100] text-black' : spent ? 'bg-[#ca8a04] text-black' : 'bg-[#18181b] text-zinc-400',
                            ]}
                          >
                            {node.rank}/{node.maxRank}
                          </span>
                          <span
                            role="tooltip"
                            class:list={[
                              'pointer-events-none invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-visible:visible group-focus-visible:opacity-100 absolute z-30 left-1/2 -translate-x-1/2 w-56 p-3 bg-black border border-[#ffd100]/70 text-left shadow-[0_0_24px_rgba(0,0,0,0.8)] normal-case tracking-normal',
                              tooltipBelow ? 'top-full mt-2' : 'bottom-full mb-2',
                            ]}
                          >
                            <span class="block text-sm font-black text-[#ffd100] leading-tight">{node.name}</span>
                            <span class="block text-[10px] font-bold tracking-widest text-zinc-400 mt-1 uppercase">Rank {node.rank}/{node.maxRank}</span>
                            {node.description && (
                              <span class="block text-xs text-zinc-300 leading-relaxed mt-2">{node.description}</span>
                            )}
                          </span>
                        </button>
                      );
                    })}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
      <p class="text-[10px] text-zinc-600 normal-case tracking-normal mt-4 mb-0">
        Talent tree layout and icons from the Blizzard Game Data API ({TALENT_TREE_SOURCE.namespace}).
      </p>
    </>
  )}
</section>

