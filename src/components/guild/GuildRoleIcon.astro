---
// Simple role glyphs (site-drawn, not game art): shield = tank, cross = healer, sword = damage.
interface Props { icon?: string; color?: string; class?: string }
const { icon = 'sword', color = 'currentColor', class: extra = 'size-4' } = Astro.props;
---
<svg class={extra} viewBox="0 0 24 24" aria-hidden="true" style={`color:${color}`}>
  {icon === 'shield' && <path d="M12 2.5l7.5 2.8v5.9c0 4.6-3.2 8.6-7.5 10.3-4.3-1.7-7.5-5.7-7.5-10.3V5.3z" fill="currentColor" />}
  {icon === 'cross' && <path d="M9.5 3h5v6.5H21v5h-6.5V21h-5v-6.5H3v-5h6.5z" fill="currentColor" />}
  {icon !== 'shield' && icon !== 'cross' && (
    <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 4l-9.5 9.5" /><path d="M20 4h-4M20 4v4" /><path d="M7.5 12.5l4 4" /><path d="M9.5 14.5L4 20" />
    </g>
  )}
</svg>
