---
// Month view + upcoming list. Months are pre-rendered; a small script picks the
// current month, wires prev/next, marks today, and hides past events.
import type { GuildConfig, GuildEvent } from '../../lib/guild';
import { calendarMonths, eventType, formatEventTime, instanceOf, planHref } from '../../lib/guild';
interface Props { config: GuildConfig; events: GuildEvent[] }
const { config, events } = Astro.props;
const months = calendarMonths(events, config.timeZone);
const dows = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const tzLabel = new Intl.DateTimeFormat('en-US', { timeZone: config.timeZone, timeZoneName: 'short' }).formatToParts(new Date()).find((p) => p.type === 'timeZoneName')?.value;
---
<div class="grid lg:grid-cols-[minmax(0,1fr)_22rem] gap-6 items-start" data-guild-calendar data-tz={config.timeZone}>
  <div class="bg-[#121215] border border-[#27272a] p-3 sm:p-4 min-w-0">
    <div class="flex items-center justify-between gap-3 mb-3">
      <button type="button" data-cal-prev class="px-3 py-1.5 text-xs font-black border border-[#27272a] text-zinc-300 hover:text-white hover:border-[#c20e0e] disabled:opacity-30 disabled:hover:border-[#27272a]" aria-label="Previous month">‹</button>
      {months.map((m, i) => <h3 class="m-0 text-sm font-black tracking-widest text-[#e4e4e7]" data-cal-label={m.key} hidden={i !== 0}>{m.label}</h3>)}
      <button type="button" data-cal-next class="px-3 py-1.5 text-xs font-black border border-[#27272a] text-zinc-300 hover:text-white hover:border-[#c20e0e] disabled:opacity-30 disabled:hover:border-[#27272a]" aria-label="Next month">›</button>
    </div>
    {months.map((m, i) => (
      <div data-cal-month={m.key} hidden={i !== 0}>
        <div class="grid grid-cols-7 gap-px mb-px">
          {dows.map((d) => <span class="text-center text-[9px] sm:text-[10px] font-bold tracking-widest text-zinc-500 py-1">{d}</span>)}
        </div>
        <div class="grid grid-cols-7 gap-px bg-[#27272a] border border-[#27272a]">
          {m.weeks.flat().map((cell) => cell ? (
            <div class="bg-black min-h-12 sm:min-h-20 p-1 sm:p-1.5 min-w-0" data-cal-day={cell.iso}>
              <span class="cal-daynum block text-[10px] sm:text-xs font-bold text-zinc-400 tabular-nums">{cell.day}</span>
              {cell.events.length > 0 && (
                <>
                  <span class="flex sm:hidden gap-0.5 mt-1 flex-wrap">
                    {cell.events.map((e) => <a href={`#event-${e.id}`} class="block size-2.5 rounded-full" style={`background:${eventType(config, e.type).color}`} aria-label={e.title}></a>)}
                  </span>
                  <span class="hidden sm:grid gap-0.5 mt-1">
                    {cell.events.map((e) => (
                      <a href={`#event-${e.id}`} class="block truncate text-[10px] leading-tight font-bold normal-case tracking-normal text-white px-1 py-0.5 border-l-2 bg-white/5 hover:bg-white/10" style={`border-color:${eventType(config, e.type).color}`} title={e.title}>{e.title}</a>
                    ))}
                  </span>
                </>
              )}
            </div>
          ) : <div class="bg-[#0b0b0d] min-h-12 sm:min-h-20" aria-hidden="true"></div>)}
        </div>
      </div>
    ))}
    <ul class="flex flex-wrap gap-x-4 gap-y-1 mt-3 m-0 p-0 list-none text-[10px] font-bold tracking-widest text-zinc-400">
      {config.eventTypes.map((t) => <li class="flex items-center gap-1.5"><span class="size-2.5 rounded-full" style={`background:${t.color}`}></span>{t.label}</li>)}
      <li class="ml-auto normal-case tracking-normal text-zinc-600 font-normal">Times in {tzLabel ?? config.timeZone}</li>
    </ul>
  </div>

  <div class="min-w-0">
    <h3 class="text-xs font-black tracking-widest text-[#c20e0e] m-0 mb-3">UPCOMING</h3>
    <ol class="grid gap-3 m-0 p-0 list-none" data-upcoming>
      {events.map((e) => {
        const t = eventType(config, e.type);
        const inst = instanceOf(config, e.instance);
        return (
          <li id={`event-${e.id}`} data-event-end={e.end ?? e.start} class="scroll-mt-28 bg-[#121215] border border-[#27272a] border-l-4 p-4 min-w-0" style={`border-left-color:${t.color}`}>
            <p class="m-0 flex flex-wrap items-center gap-2 text-[10px] font-black tracking-widest">
              <span style={`color:${t.color}`}>{t.label}</span>
              {e.example && <span class="px-1.5 py-0.5 border border-[#ffd100]/60 text-[#ffd100]">EXAMPLE</span>}
            </p>
            <p class="m-0 mt-1 text-base font-black text-[#e4e4e7] normal-case tracking-wide">{e.title}</p>
            <p class="m-0 mt-1 text-xs text-zinc-400 normal-case tracking-normal">{formatEventTime(e, config.timeZone)}{inst && ` · ${inst.name}`}</p>
            {e.description && <p class="m-0 mt-2 text-xs text-zinc-500 normal-case tracking-normal leading-relaxed">{e.description}</p>}
            {e.plan && <a href={planHref(config, e.plan)} class="inline-block mt-3 text-[10px] font-black tracking-widest text-white bg-[#c20e0e] hover:bg-[#9e0b0b] px-3 py-1.5 border border-[#d30000]">VIEW GROUP PLAN</a>}
          </li>
        );
      })}
    </ol>
    <p class="text-zinc-500 text-sm normal-case m-0" data-upcoming-empty hidden>No upcoming events.</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-guild-calendar]').forEach((root) => {
    const tz = root.dataset.tz || 'UTC';
    const parts = Object.fromEntries(new Intl.DateTimeFormat('en-US', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date()).map((p) => [p.type, p.value]));
    const todayIso = `${parts.year}-${parts.month}-${parts.day}`;
    const monthKey = todayIso.slice(0, 7);
    const months = [...root.querySelectorAll<HTMLElement>('[data-cal-month]')];
    const labels = [...root.querySelectorAll<HTMLElement>('[data-cal-label]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-cal-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-cal-next]')!;
    let idx = Math.max(0, months.findIndex((m) => m.dataset.calMonth === monthKey));
    const show = () => {
      months.forEach((m, i) => (m.hidden = i !== idx));
      labels.forEach((l, i) => (l.hidden = i !== idx));
      prev.disabled = idx === 0;
      next.disabled = idx === months.length - 1;
    };
    prev.addEventListener('click', () => { if (idx > 0) { idx--; show(); } });
    next.addEventListener('click', () => { if (idx < months.length - 1) { idx++; show(); } });
    show();
    const today = root.querySelector<HTMLElement>(`[data-cal-day="${todayIso}"]`);
    today?.classList.add('outline', 'outline-1', 'outline-[#c20e0e]', '-outline-offset-1');
    today?.querySelector('.cal-daynum')?.classList.add('text-[#c20e0e]');
    const now = Date.now();
    let visible = 0;
    root.querySelectorAll<HTMLElement>('[data-event-end]').forEach((li) => {
      const past = Date.parse(li.dataset.eventEnd || '') < now;
      li.hidden = past;
      if (!past) visible++;
    });
    const empty = root.querySelector<HTMLElement>('[data-upcoming-empty]');
    if (empty) empty.hidden = visible > 0;
  });
</script>
